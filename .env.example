# Environment variables: names only. Values live in .env.local (gitignored) and in Vercel.
# Pull them locally with: vercel env pull .env.local

# Postgres (Neon via the Vercel Marketplace integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Image generation (Cloudflare Workers AI, free tier)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Session signing (32+ random bytes). Set as Sensitive in Vercel.
AUTH_SECRET=

# Guest sessions allowed per IP per hour (default 30)
GUEST_LIMIT_PER_HOUR=
